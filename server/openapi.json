                                    "$ref": "#/components/schemas/EconomicGrowthSyncResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Slug and data are required"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized access due to missing or invalid API key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "API Key is missing. Access denied"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
