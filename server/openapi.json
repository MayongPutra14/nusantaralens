                                "data": [
                                    {
                                        "keterangan": "total_bangka_belitung",
                                        "tahun": 2025,
                                        "laki_laki": 795200,
                                        "perempuan": 755600,
                                        "total_keseluruhan": 1550800
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Economic growths data synchronized successfully",
