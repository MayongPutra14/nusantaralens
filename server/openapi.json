{
    "openapi": "3.0.3",
    "info": {
        "title": "Nusantaralens API",
        "version": "1.0.0",
        "description": "This API serves as the central data provider for Nusantaralens, a platform focused on showcasing Indonesia's rich heritage. It provides structured access to a comprehensive collection of data regarding Indonesian national heroes, cultural diversity, and local languages. The API supports data retrieval operations (GET) for seamless access to cultural resources, as well as secure administrative management capabilities (POST) for data synchronization.",
        "contact": {
            "name": "Gilang Mayong Saputra",
            "email": "gilang46622@gmail.com"
        },
        "license": {
            "name": "MIT License",
            "url": "https://mit-license.org/"
        }
    },
    "servers": [
        {
            "url": "https://nusantaralens.vercel.app",
            "description": "Production Server (Live)"
        },
        {
            "url": "http://localhost:5000",
            "description": "Development Server (Local)"
        }
    ],
    "paths": {
        "/heroes": {
            "get": {
                "tags": [
                    "Heroes"
                ],
                "summary": "Get all heroes",
                "description": "Retrieve all heroes data successfully.",
                "responses": {
                    "200": {
                        "description": "Heroes data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HeroesResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/culture": {
            "get": {
                "tags": [
                    "Cultures"
                ],
                "summary": "Get all cultures",
                "description": "Retrieve all cultures data successfully.",
                "responses": {
                    "200": {
                        "description": "Cultures data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CulturesResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/language/{iso_code}/words": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Get words by language iso code",
                "description": "Retrieve language words based on iso code.",
                "parameters": [
                    {
                        "name": "iso_code",
                        "in": "path",
                        "required": true,
                        "description": "ISO code of regional language",
                        "schema": {
                            "type": "string",
                            "example": "ace"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Language words retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WordsResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Language not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/sync/populations": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Synchronize population data",
                "description": "This endpoint is used to manually synchronize population data into the database from external or local sources. Access is restricted and requires a valid x-api-key in the request headers.",
                "security": [
                    {
                        "AdminApiKey": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PopulationSyncRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Population data synchronized successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PopulationSyncResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized access due to missing API key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/islands/{islandSlug}": {
            "get": {
                "tags": [
                    "Islands"
                ],
                "summary": "Get island data by slug",
                "description": "Retrieve island population data based on the provided island slug.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "islandSlug",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "nusa-tengara-barat",
                        "description": "Island slug using lowercase and kebab-case format. Examples: bali, kepulauan-riau, nusa-tenggara-barat."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Island data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IslandResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Island not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "AdminApiKey": {
                "type": "apiKey",
                "in": "header",
                "name": "x-api-key",
                "description": "API key used to authorize admin synchronization requests."
            }
        },
        "schemas": {
            "Hero": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Ir. Soekarno"
                    },
                    "ascencion_document_number": {
                        "type": "string",
                        "example": "83/TK/TAHUN 2012"
                    },
                    "ascencion_document_date": {
                        "type": "string",
                        "example": "07 November 2012"
                    },
                    "ascencion_year": {
                        "type": "integer",
                        "example": 2012
                    },
                    "photo_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/photo.webp"
                    },
                    "birth_date": {
                        "type": "string",
                        "example": "06 Juni 1901"
                    },
                    "birth_place": {
                        "type": "string",
                        "example": "Surabaya, Jawa Timur"
                    },
                    "death_date": {
                        "type": "string",
                        "example": "21 Juni 1970"
                    },
                    "death_place": {
                        "type": "string",
                        "example": "Jakarta"
                    },
                    "burial_place": {
                        "type": "string",
                        "example": "Makam Bung Karno, Blitar, Jawa Timur"
                    },
                    "description": {
                        "type": "string",
                        "example": "Proklamator Kemerdekaan Indonesia dan Presiden pertama Republik Indonesia yang merumuskan Pancasila sebagai dasar negara."
                    }
                }
            },
            "Culture": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Wayang Kulit"
                    },
                    "photo_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/culture.webp"
                    },
                    "description": {
                        "type": "string",
                        "example": "Wayang Kulit adalah seni pertunjukan tradisional."
                    }
                }
            },
            "Word": {
                "type": "object",
                "properties": {
                    "indonesia": {
                        "type": "string",
                        "example": "adik"
                    },
                    "daerah": {
                        "type": "string",
                        "example": "adek"
                    }
                }
            },
            "PopulationSync": {
                "type": "object",
                "properties": {
                    "keterangan": {
                        "type": "string",
                        "example": "total_bangka_belitung"
                    },
                    "tahun": {
                        "type": "integer",
                        "example": 2025
                    },
                    "laki_laki": {
                        "type": "integer",
                        "example": 795200
                    },
                    "perempuan": {
                        "type": "integer",
                        "example": 755600
                    },
                    "total_keseluruhan": {
                        "type": "integer",
                        "example": 1550800
                    }
                }
            },
            "PopulationSyncRequest": {
                "type": "object",
                "properties": {
                    "region": {
                        "type": "string",
                        "example": "Bangka Belitung"
                    },
                    "slug": {
                        "type": "string",
                        "example": "bangka-belitung"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PopulationSync"
                        }
                    }
                }
            },
            "Island": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 3
                    },
                    "slug": {
                        "type": "string",
                        "example": "bali"
                    },
                    "year": {
                        "type": "integer",
                        "example": 2025
                    },
                    "region": {
                        "type": "string",
                        "example": "Bali"
                    },
                    "male_population": {
                        "type": "string",
                        "example": "2234600"
                    },
                    "female_population": {
                        "type": "string",
                        "example": "2226700"
                    },
                    "total_population": {
                        "type": "string",
                        "example": "4461300"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-06-01T14:04:23.662Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-06-01T14:04:23.662Z"
                    }
                }
            },
            "HeroesData": {
                "type": "object",
                "properties": {
                    "heroes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Hero"
                        }
                    }
                }
            },
            "CulturesData": {
                "type": "object",
                "properties": {
                    "cultures": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Culture"
                        }
                    }
                }
            },
            "WordsData": {
                "type": "object",
                "properties": {
                    "words": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Word"
                        }
                    }
                }
            },
            "PopulationSyncData": {
                "type": "object",
                "properties": {
                    "total_data": {
                        "type": "integer",
                        "example": 1
                    },
                    "region": {
                        "type": "object",
                        "properties": {
                            "city": {
                                "type": "string",
                                "example": "Bangka Belitung"
                            },
                            "start_year": {
                                "type": "integer",
                                "example": 2025
                            },
                            "end_year": {
                                "type": "integer",
                                "example": 2025
                            }
                        }
                    }
                }
            },
            "IslandData": {
                "type": "object",
                "properties": {
                    "island": {
                        "$ref": "#/components/schemas/Island"
                    }
                }
            },
            "HeroesResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Heroes data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/HeroesData"
                    }
                }
            },
            "CulturesResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Cultures data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/CulturesData"
                    }
                }
            },
            "WordsResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Words data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/WordsData"
                    }
                }
            },
            "PopulationSyncResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Population data for Bangka Belitung synced successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/PopulationSyncData"
                    }
                }
            },
            "IslandResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Retrieved data island succesfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/IslandData"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "error"
                    },
                    "message": {
                        "type": "string",
                        "example": "Internal server error"
                    }
                }
            },
            "FailedResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "failed"
                    },
                    "message": {
                        "type": "string",
                        "example": "Resource not found"
                    }
                }
            }
        }
    }
}