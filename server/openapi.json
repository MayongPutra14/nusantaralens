{
    "openapi": "3.0.3",
    "info": {
        "title": "Nusantaralens API",
        "version": "1.0.0",
        "description": "This API serves as the central data provider for Nusantaralens, a platform focused on showcasing Indonesia's rich heritage. It provides structured access to a comprehensive collection of data regarding Indonesian national heroes, cultural diversity, and local languages. The API supports data retrieval operations (GET) for seamless access to cultural resources, as well as secure administrative management capabilities (POST) for data synchronization.",
        "contact": {
            "name": "Gilang Mayong Saputra",
            "email": "gilang46622@gmail.com"
        },
        "license": {
            "name": "MIT License",
            "url": "https://mit-license.org/"
        }
    },
    "servers": [
        {
            "url": "https://nusantaralens.vercel.app",
            "description": "Production Server (Live)"
        },
        {
            "url": "http://localhost:5000",
            "description": "Development Server (Local)"
        }
    ],
    "paths": {
        "/heroes": {
            "get": {
                "tags": [
                    "Heroes"
                ],
                "summary": "Get all heroes",
                "description": "Retrieve all heroes data successfully.",
                "responses": {
                    "200": {
                        "description": "Heroes data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HeroesResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/culture": {
            "get": {
                "tags": [
                    "Cultures"
                ],
                "summary": "Get all cultures",
                "description": "Retrieve all cultures data successfully.",
                "responses": {
                    "200": {
                        "description": "Cultures data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CulturesResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/iso-code": {
            "get": {
                "tags": [
                    "Languages ISO Code"
                ],
                "summary": "Get all ISO languages codes",
                "description": "Retrieve all available ISO codes successfully.",
                "responses": {
                    "200": {
                        "description": "ISO codes retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ISOCodeResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/language/{iso_code}/words": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Get words by language iso code",
                "description": "Retrieve language words based on iso code.",
                "parameters": [
                    {
                        "name": "iso_code",
                        "in": "path",
                        "required": true,
                        "description": "ISO code of regional language",
                        "schema": {
                            "type": "string",
                            "example": "ace"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Language words retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/WordsResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Language not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Resource not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/islands/{islandSlug}": {
            "get": {
                "tags": [
                    "Islands"
                ],
                "summary": "Get island detail by slug",
                "description": "Retrieve detailed information about a specific island, including population, economic growth, and land area statistics.",
                "parameters": [
                    {
                        "in": "path",
                        "name": "islandSlug",
                        "required": true,
                        "description": "Unique slug identifier of the island.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "bangka-belitung",
                                "bali",
                                "kepulauan-riau",
                                "maluku",
                                "maluku-utara",
                                "nusa-tenggara-barat",
                                "nusa-tenggara-timur",
                                "papua",
                                "jawa",
                                "kalimantan",
                                "sumatera",
                                "sulawesi"
                            ]
                        },
                        "example": "sumatera"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Island data retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IslandResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Island not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Resource not found"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/sync/populations": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Synchronize population data",
                "description": "Synchronize population statistics for a specific region into the database. This endpoint accepts population datasets and performs data synchronization based on the provided region and island slug. Access is restricted and requires a valid x-api-key.",
                "security": [
                    {
                        "AdminApiKey": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PopulationSyncRequest"
                            },
                            "example": {
                                "region": "Bangka Belitung",
                                "slug": "bangka-belitung",
                                "data": [
                                    {
                                        "keterangan": "total_bangka_belitung",
                                        "tahun": 2025,
                                        "laki_laki": 795200,
                                        "perempuan": 755600,
                                        "total_keseluruhan": 1550800
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Population data synchronized successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PopulationSyncResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Invalid request body. Region, slug, and data array are required."
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized access due to missing or invalid API key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "API Key is missing. Access denied"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/sync/economic-growths": {
            "post": {
                "tags": [
                    "Admin"
                ],
                "summary": "Synchronize economic growth data",
                "description": "Synchronize economic growth statistics for a specific island into the database. This endpoint accepts economic growth datasets and performs data synchronization based on the provided island slug. Access is restricted and requires a valid x-api-key.",
                "security": [
