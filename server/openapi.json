        "/chat/messages": {
            "post": {
                "tags": [
                    "AI Assistant"
                ],
                "summary": "Send a message to the AI assistant",
                "description": "Send a text prompt, an image, or both to interact with the AI assistant. Images are first analyzed by the image recognition model, and the result is then combined with the conversation context and processed by Gemini to generate a response. Conversation history is maintained using the provided sessionId. At least one of prompt or image must be provided.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/AIChatRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "AI response generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AIChatResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request, missing prompt/image or unsupported image format",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FailedResponse"
                                },
                                "example": {
                                    "status": "failed",
                                    "message": "Prompt or image is required"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "AdminApiKey": {
                "type": "apiKey",
                "in": "header",
                "name": "x-api-key",
                "description": "API key used to authorize admin synchronization requests."
            }
        },
        "schemas": {
            "Hero": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Ir. Soekarno"
                    },
                    "ascencion_document_number": {
                        "type": "string",
                        "example": "83/TK/TAHUN 2012"
                    },
                    "ascencion_document_date": {
                        "type": "string",
                        "example": "07 November 2012"
                    },
                    "ascencion_year": {
                        "type": "integer",
                        "example": 2012
                    },
                    "photo_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/photo.webp"
                    },
                    "birth_date": {
                        "type": "string",
                        "example": "06 Juni 1901"
                    },
                    "birth_place": {
                        "type": "string",
                        "example": "Surabaya, Jawa Timur"
                    },
                    "death_date": {
                        "type": "string",
                        "example": "21 Juni 1970"
                    },
                    "death_place": {
                        "type": "string",
                        "example": "Jakarta"
                    },
                    "burial_place": {
                        "type": "string",
                        "example": "Makam Bung Karno, Blitar, Jawa Timur"
                    },
                    "description": {
                        "type": "string",
                        "example": "Proklamator Kemerdekaan Indonesia dan Presiden pertama Republik Indonesia yang merumuskan Pancasila sebagai dasar negara."
                    }
                }
            },
            "HeroesData": {
                "type": "object",
                "properties": {
                    "heroes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Hero"
                        }
                    }
                }
            },
            "HeroesResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Heroes data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/HeroesData"
                    }
                }
            },
            "Culture": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Wayang Kulit"
                    },
                    "photo_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://example.com/culture.webp"
                    },
                    "description": {
                        "type": "string",
                        "example": "Wayang Kulit adalah seni pertunjukan tradisional."
                    }
                }
            },
            "CulturesData": {
                "type": "object",
                "properties": {
                    "cultures": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Culture"
                        }
                    }
                }
            },
            "CulturesResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Cultures data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/CulturesData"
                    }
                }
            },
            "Word": {
                "type": "object",
                "properties": {
                    "indonesia": {
                        "type": "string",
                        "example": "adik"
                    },
                    "daerah": {
                        "type": "string",
                        "example": "adek"
                    }
                }
            },
            "WordsData": {
                "type": "object",
                "properties": {
                    "words": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Word"
                        }
                    }
                }
            },
            "WordsResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Words data retrieved successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/WordsData"
                    }
                }
            },
            "ISOCode": {
                "type": "string",
                "example": "jv",
                "description": "An ISO language code."
            },
            "ISOCodeData": {
                "type": "object",
                "properties": {
                    "iso_codes": {
                        "type": "array",
                        "description": "List of available ISO language codes.",
                        "items": {
                            "$ref": "#/components/schemas/ISOCode"
                        }
                    }
                }
            },
            "ISOCodeResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Retrieved all iso codes successfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/ISOCodeData"
                    }
                }
            },
            "Island": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 11
                    },
                    "slug": {
                        "type": "string",
                        "example": "sumatera"
                    },
                    "name": {
                        "type": "string",
                        "example": "Sumatera"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "IslandData": {
                "type": "object",
                "properties": {
                    "island": {
                        "$ref": "#/components/schemas/Island"
                    },
                    "populations": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Population"
                        }
                    },
                    "economic_growths": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/EconomicGrowth"
                        }
                    },
                    "land_areas": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LandArea"
                        }
                    }
                }
            },
            "IslandResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Retrieved data island succesfully"
                    },
                    "data": {
                        "$ref": "#/components/schemas/IslandData"
                    }
                }
            },
            "Population": {
                "type": "object",
                "properties": {
                    "year": {
                        "type": "integer",
                        "example": 2025
                    },
                    "male_population": {
                        "type": "string",
                        "example": "31669400"
                    },
                    "female_population": {
                        "type": "string",
                        "example": "30972546"
                    },
                    "total_population": {
                        "type": "string",
                        "example": "62641946"
                    }
                }
            },
            "EconomicGrowth": {
                "type": "object",
                "properties": {
                    "year": {
                        "type": "integer",
                        "example": 2025
                    },
                    "growth_rate": {
                        "type": "string",
                        "example": "4.81"
                    }
                }
            },
            "LandArea": {
                "type": "object",
                "properties": {
                    "year": {
                        "type": "integer",
                        "example": 2025
                    },
                    "land_area_km2": {
                        "type": "string",
                        "example": "475609.77"
                    },
                    "land_area_percentage": {
                        "type": "string",
                        "example": "25.69"
                    }
                }
            },
            "PopulationSyncItem": {
                "type": "object",
                "properties": {
                    "keterangan": {
                        "type": "string",
                        "example": "total_bangka_belitung"
                    },
                    "tahun": {
                        "type": "integer",
                        "example": 2025
                    },
                    "laki_laki": {
                        "type": "integer",
                        "example": 795200
                    },
                    "perempuan": {
                        "type": "integer",
                        "example": 755600
                    },
                    "total_keseluruhan": {
                        "type": "integer",
                        "example": 1550800
                    }
                }
            },
            "PopulationSyncRequest": {
                "type": "object",
                "required": [
                    "region",
                    "slug",
                    "data"
                ],
                "properties": {
                    "region": {
                        "type": "string",
                        "example": "Bangka Belitung"
                    },
                    "slug": {
                        "type": "string",
                        "example": "bangka-belitung"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PopulationSyncItem"
                        }
                    }
                }
            },
            "PopulationSyncResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Population data for Bangka Belitung synced successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "total_data": {
                                "type": "integer",
                                "example": 1
                            },
                            "region": {
                                "type": "object",
                                "properties": {
                                    "city": {
                                        "type": "string",
