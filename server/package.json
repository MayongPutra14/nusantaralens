{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend API service designed to manage database operations and provide seamless integration for Data Science models and AI features.",
  "homepage": "https://github.com/Abudann/nusantaralens#readme",
  "bugs": {
    "url": "https://github.com/Abudann/nusantaralens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abudann/nusantaralens.git"
  },
  "license": "ISC",
  "author": "Gilang Mayong Saputra",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "dotenv -e .env node-pg-migrate up",
    "migrate:up:prod": "dotenv -e .env.production node-pg-migrate up",
    "migrate:down": "dotenv -e .env node-pg-migrate down",
    "migrate:down:prod": "dotenv -e .env.production node-pg-migrate down",
    "start:prod": "cross-env NODE_ENV=production nodemon -r dotenv/config ./src/server.js dotenv_config_path=.env.production",
    "start:dev": "cross-env NODE_ENV=development nodemon ./src/server.js",
    "seed:heroes:dev": "cross-env NODE_ENV=development dotenv -e .env node ./src/data/heroes/seeder-hero.js",
    "seed:heroes:prod": "cross-env NODE_ENV=production dotenv -e .env.production node ./src/data/heroes/seeder-hero.js",
    "seed:languages:dev": "cross-env NODE_ENV=development dotenv -e .env node ./src/data/languages/seeder-language.js",
    "seed:languages:prod": "cross-env NODE_ENV=production dotenv -e .env.production node ./src/data/languages/seeder-language.js",
    "seed:cultures:dev": "cross-env NODE_ENV=development dotenv -e .env node ./src/data/cultures/seeder-cultures.js",
    "seed:cultures:prod": "cross-env NODE_ENV=production dotenv -e .env.production node ./src/data/cultures/seeder-cultures.js",
    "seed:populations:dev": "dotenv -e .env node ./src/data/populations/seeder-population.js",
    "seed:populations:prod": "dotenv -e .env.production node ./src/data/populations/seeder-population.js",
    "seed:economics:dev": "cross-env NODE_ENV=development dotenv -e .env node ./src/data/economic_growths/seeder-economic-growths.js",
    "seed:economics:prod": "cross-env NODE_ENV=production dotenv -e .env.production node ./src/data/economic_growths/seeder-economic-growths.js",
    "seed:lands:dev": "cross-env NODE_ENV=development dotenv -e .env node ./src/data/land_areas/seeder-land-areas.js",
    "seed:lands:prod": "cross-env NODE_ENV=production dotenv -e .env.production node ./src/data/land_areas/seeder-land-areas.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "axios": "^1.16.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "joi": "^18.2.1",
    "multer": "^2.1.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "eslint-config-dicodingacademy": "^0.9.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14"
  }
}